# Copiá este archivo a `.env` y completá los valores reales.
# NUNCA commitear `.env` (ya está en .gitignore).

# Perfil de Spring. Sin definir se usa "dev" (credenciales locales de
# application-dev.yaml). En producción: prod, y DB_PASSWORD/JWT_SECRET son obligatorias.
# SPRING_PROFILES_ACTIVE=prod

# Password de la base de datos PostgreSQL.
# En desarrollo dejalo comentado (usa el de application-dev.yaml). Un valor de
# ejemplo copiado tal cual pisa el de desarrollo.
# DB_PASSWORD=

# Clave HMAC-SHA256 en Base64 (mínimo 32 bytes / 256 bits). Obligatoria en producción.
# Generar con:  openssl rand -base64 32
# En desarrollo dejala comentada (usa la de application-dev.yaml): un texto que no
# sea base64 hace que el backend no arranque.
# JWT_SECRET=

# Expiración del access token en milisegundos (15 min por defecto).
JWT_EXPIRATION=900000

# API key de Resend para emails (invitaciones, reset de contraseña).
# Sin key, los emails no se envían y su contenido se escribe en el log del backend.
RESEND_API_KEY=

# Remitente. Con "onboarding@resend.dev" (modo prueba) Resend SOLO entrega al
# email de tu cuenta de Resend; para mandar a cualquiera, verificá un dominio.
RESEND_FROM=PrintOps <onboarding@resend.dev>

# Escribir los emails en el log si no hay key. Por defecto: true en dev, false en prod.
# EMAIL_LOG_WHEN_DISABLED=true
