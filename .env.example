# Variables de entorno del backend (12-factor). Copiá este archivo a `.env` para
# desarrollo local y completá lo necesario. NUNCA commitear `.env` (está en .gitignore).
# En Azure estas mismas variables se cargan en el Container App: los secretos como
# "secrets" del app (scripts/azure.py deploy), nunca en GitHub ni en la imagen.

# ---------- General ----------
# Perfil de Spring. Sin definir se usa "dev" (credenciales locales de application-dev.yaml).
# La imagen Docker ya trae SPRING_PROFILES_ACTIVE=prod: ahí JWT_SECRET y DB_PASSWORD son obligatorias.
# SPRING_PROFILES_ACTIVE=prod

# Puerto HTTP (default 8083). Container Apps manda el tráfico a este puerto (--target-port).
# PORT=8083

# URL pública del backend: se usa para armar el link de verificación de email.
# APP_BASE_URL=http://localhost:8083

# ---------- Base de datos (PostgreSQL) ----------
# JDBC URL. En Azure: jdbc:postgresql://<servidor>.postgres.database.azure.com:5432/printops?sslmode=require
# DB_URL=jdbc:postgresql://localhost:5432/printops
# DB_USERNAME=printops
# Password. En desarrollo dejala comentada (usa la de application-dev.yaml).
# DB_PASSWORD=
# Tamaño máximo del pool HikariCP (default 5).
# DB_POOL_SIZE=5

# ---------- Seguridad ----------
# Clave HMAC-SHA256 en Base64, mínimo 32 bytes (256 bits). Obligatoria en producción.
# Generar con:  openssl rand -base64 32
# En desarrollo dejala comentada: un texto que no sea base64 hace que el backend no arranque.
# JWT_SECRET=

# Expiración del access token en milisegundos (default 15 min).
# JWT_EXPIRATION=900000

# ---------- Observabilidad ----------
# Connection string de Application Insights (portal → Application Insights → Overview).
# Sin definir, el agente no envía telemetría y la app arranca igual.
# APPLICATIONINSIGHTS_CONNECTION_STRING=
# Nombre con el que aparece el servicio en Application Insights (la imagen ya lo define).
# APPLICATIONINSIGHTS_ROLE_NAME=printops-backend

# ---------- Email (Resend) ----------
# API key de Resend. Sin key, los emails no se envían.
# RESEND_API_KEY=
# Remitente. Con "onboarding@resend.dev" Resend solo entrega al email de tu cuenta.
# RESEND_FROM=PrintOps <onboarding@resend.dev>
# Sin key, escribir el contenido de los emails (códigos de verificación) en el log.
# Default: true en dev, false en prod. Para la demo en Azure sin Resend: true.
# EMAIL_LOG_WHEN_DISABLED=true

# ---------- Métricas ----------
# Tarifa horaria del operario para el costo de mano de obra (default 20.0).
# METRICS_OPERATOR_HOURLY_RATE=20.0
