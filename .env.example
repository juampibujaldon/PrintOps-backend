# Copiá este archivo a `.env` y completá los valores reales.
# NUNCA commitear `.env` (ya está en .gitignore).

# Password de la base de datos PostgreSQL.
DB_PASSWORD=tu_password_aqui

# Clave HMAC-SHA256 en Base64 (mínimo 32 bytes / 256 bits).
# Generar con, por ejemplo:  openssl rand -base64 32
JWT_SECRET=genera_una_clave_de_al_menos_256_bits

# Expiración del access token en milisegundos (15 min por defecto).
JWT_EXPIRATION=900000
